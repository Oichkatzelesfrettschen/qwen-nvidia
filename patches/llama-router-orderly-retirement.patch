+void server_models::unload_orderly(const std::string & name) {
+    {
+        std::unique_lock<std::mutex> lk(mutex);
+        cv.wait(lk, [this]() { return !orderly_retirement_running; });
+        if (orderly_retirement_failed) {
+            throw std::runtime_error("orderly retirement is latched failed");
+        }
+        auto it = mapping.find(name);
+        if (it == mapping.end() || it->second.req_count != 0 || !it->second.meta.is_ready_or_sleep()) {
+            throw std::runtime_error("orderly retirement requires an idle running model name=" + name);
+        }
+        it->second.subproc->reset_teardown_exclusion();
+        orderly_retirement_running = true;
+    }
+
+    bool accepted = false;
+    try {
+        const char * retirement_command = getenv("QWEN_ROUTER_RETIRE_COMMAND");
+        if (retirement_command == nullptr || retirement_command[0] == '\0') {
+            throw std::runtime_error("capacity retirement requires QWEN_ROUTER_RETIRE_COMMAND");
+        }
+        common_subproc retirement;
+        const std::vector<std::string> retirement_args = {
+            retirement_command, name, std::to_string(base_params.port),
+        };
+        if (!retirement.create(retirement_args,
+                subprocess_option_no_window | subprocess_option_combined_stdout_stderr, base_env)) {
+            throw std::runtime_error("failed to start orderly retirement for model name=" + name);
+        }
+        FILE * output = retirement.stdout_file();
+        std::string log;
+        int retirement_status = -1;
+        bool retirement_reaped = false;
+        if (output != nullptr) {
+            const int output_descriptor = fileno(output);
+            const int descriptor_flags = fcntl(output_descriptor, F_GETFL, 0);
+            if (descriptor_flags < 0 ||
+                    fcntl(output_descriptor, F_SETFL, descriptor_flags | O_NONBLOCK) < 0) {
+                retirement.terminate();
+                retirement.join();
+                throw std::runtime_error("failed to make orderly retirement output nonblocking for model name=" + name);
+            }
+            int64_t retirement_timeout_ms = 45000;
+            if (const char * configured_timeout = getenv("QWEN_ROUTER_RETIREMENT_TIMEOUT_MS")) {
+                char * end = nullptr;
+                const long long parsed_timeout = strtoll(configured_timeout, &end, 10);
+                if (end == configured_timeout || *end != '\0' ||
+                        parsed_timeout < 100 || parsed_timeout > 120000) {
+                    retirement.terminate();
+                    retirement.join();
+                    throw std::runtime_error("invalid QWEN_ROUTER_RETIREMENT_TIMEOUT_MS");
+                }
+                retirement_timeout_ms = parsed_timeout;
+            }
+            const int64_t deadline = ggml_time_ms() + retirement_timeout_ms;
+            bool output_closed = false;
+            auto drain_output = [&]() {
+                while (!output_closed) {
+                    char chunk[4096];
+                    const ssize_t byte_count = read(output_descriptor, chunk, sizeof(chunk));
+                    if (byte_count > 0) {
+                        log.append(chunk, (size_t) byte_count);
+                        LOG("router retirement: %.*s", (int) byte_count, chunk);
+                        continue;
+                    }
+                    if (byte_count == 0) {
+                        output_closed = true;
+                    } else if (errno != EAGAIN && errno != EWOULDBLOCK && errno != EINTR) {
+                        output_closed = true;
+                    }
+                    break;
+                }
+            };
+            while (ggml_time_ms() < deadline) {
+                struct pollfd descriptor { output_descriptor, POLLIN | POLLHUP, 0 };
+                const int poll_status = poll(&descriptor, 1, 100);
+                if (poll_status < 0 && errno != EINTR) {
+                    break;
+                }
+                if (poll_status > 0 && (descriptor.revents & (POLLIN | POLLHUP))) {
+                    drain_output();
+                }
+                if (!retirement.alive()) {
+                    retirement_reaped = true;
+                    // alive() caches the direct child's exit status. Drain its
+                    // final bytes before join() closes the stream; an inherited
+                    // writer may keep EOF away.
+                    drain_output();
+                    break;
+                }
+            }
+            if (!retirement_reaped) {
+                retirement.terminate();
+                retirement.join();
+                throw std::runtime_error("orderly retirement command reached its deadline for model name=" + name);
+            }
+            retirement_status = retirement.join();
+        }
+        const int status = retirement_status;
+        std::lock_guard<std::mutex> lk(mutex);
+        auto it = mapping.find(name);
+        accepted = status == 0 && log.find("teardown_exclusion=orderly") != std::string::npos &&
+            it != mapping.end() && it->second.meta.status == SERVER_MODEL_STATUS_UNLOADED &&
+            it->second.subproc->get_teardown_exclusion() == "orderly";
+        if (accepted) {
+            const char * barrier_identity = getenv("QWEN_GPU_ADMISSION_IDENTITY");
+            common_subproc resume;
+            const std::vector<std::string> resume_args = {
+                retirement_command, "--resume", barrier_identity == nullptr ? "" : barrier_identity,
+            };
+            if (!resume.create(resume_args,
+                    subprocess_option_no_window | subprocess_option_combined_stdout_stderr, base_env)) {
+                accepted = false;
+            } else {
+                const int64_t resume_deadline = ggml_time_ms() + 5000;
+                while (resume.alive() && ggml_time_ms() < resume_deadline) {
+                    std::this_thread::sleep_for(std::chrono::milliseconds(10));
+                }
+                if (resume.alive()) {
+                    resume.terminate();
+                    resume.join();
+                    accepted = false;
+                } else {
+                    const int resume_status = resume.join();
+                    SRV_INF("router admission resume status=%d identity=%s\n",
+                            resume_status, barrier_identity == nullptr ? "missing" : barrier_identity);
+                    accepted = resume_status == 0;
+                }
+            }
+            if (accepted) {
+                try {
+                    auto resumed_admission = router_admission_share::acquire();
+                } catch (const std::exception & error) {
+                    SRV_ERR("router admission resume verification failed: %s\n", error.what());
+                    accepted = false;
+                }
+            }
+        }
+    } catch (...) {
+        std::lock_guard<std::mutex> lk(mutex);
+        orderly_retirement_running = false;
+        orderly_retirement_failed = true;
+        cv.notify_all();
+        throw;
+    }
+    {
+        std::lock_guard<std::mutex> lk(mutex);
+        orderly_retirement_running = false;
+        orderly_retirement_failed = !accepted;
+        cv.notify_all();
+    }
+    if (!accepted) {
+        throw std::runtime_error("orderly retirement was not established for model name=" + name);
+    }
+}
