+struct router_admission_share {
+    int descriptor = -1;
+
+    ~router_admission_share() {
+#if !defined(_WIN32)
+        if (descriptor >= 0) {
+            flock(descriptor, LOCK_UN);
+            close(descriptor);
+        }
+#endif
+    }
+
+    static std::shared_ptr<router_admission_share> acquire() {
+        const char * directory = getenv("QWEN_GPU_ADMISSION_BARRIER");
+        const char * identity = getenv("QWEN_GPU_ADMISSION_IDENTITY");
+        if (directory == nullptr || directory[0] == '\0' || identity == nullptr || identity[0] == '\0') {
+            throw std::runtime_error("router admission barrier identity is not configured");
+        }
+#if defined(_WIN32)
+        throw std::runtime_error("router admission barrier requires POSIX flock");
+#else
+        const std::string state_path = std::string(directory) + "/admission.barrier";
+        const std::string inflight_path = std::string(directory) + "/admission.inflight";
+        int state_fd = open(state_path.c_str(), O_RDONLY | O_CLOEXEC);
+        if (state_fd < 0 || flock(state_fd, LOCK_SH) != 0) {
+            if (state_fd >= 0) close(state_fd);
+            throw std::runtime_error("router admission state is unavailable");
+        }
+        char state[32] = {};
+        const ssize_t state_size = pread(state_fd, state, sizeof(state) - 1, 0);
+        flock(state_fd, LOCK_UN);
+        close(state_fd);
+        if (state_size <= 0 || std::string(state, (size_t) state_size).find("running\n") != 0) {
+            throw std::runtime_error("router admission barrier is quiescing");
+        }
+        auto share = std::make_shared<router_admission_share>();
+        share->descriptor = open(inflight_path.c_str(), O_RDONLY | O_CLOEXEC);
+        if (share->descriptor < 0 || flock(share->descriptor, LOCK_SH | LOCK_NB) != 0) {
+            throw std::runtime_error("router admission share is unavailable");
+        }
+        struct stat stat_buffer {};
+        if (fstat(share->descriptor, &stat_buffer) != 0) {
+            throw std::runtime_error("router admission identity is unreadable");
+        }
+        const std::string actual = std::to_string(stat_buffer.st_dev) + ":" + std::to_string(stat_buffer.st_ino);
+        if (actual != identity) {
+            throw std::runtime_error("router admission barrier identity mismatch");
+        }
+        state_fd = open(state_path.c_str(), O_RDONLY | O_CLOEXEC);
+        if (state_fd < 0 || flock(state_fd, LOCK_SH) != 0) {
+            if (state_fd >= 0) close(state_fd);
+            throw std::runtime_error("router admission state recheck is unavailable");
+        }
+        memset(state, 0, sizeof(state));
+        const ssize_t recheck_size = pread(state_fd, state, sizeof(state) - 1, 0);
+        flock(state_fd, LOCK_UN);
+        close(state_fd);
+        if (recheck_size <= 0 || std::string(state, (size_t) recheck_size).find("running\n") != 0) {
+            throw std::runtime_error("router admission barrier closed after share acquisition");
+        }
+        return share;
+#endif
+    }
+};
