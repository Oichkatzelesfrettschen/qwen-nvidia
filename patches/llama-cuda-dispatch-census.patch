diff --git a/ggml/src/ggml-cuda/dispatch-census.cu b/ggml/src/ggml-cuda/dispatch-census.cu
new file mode 100644
index 000000000..a0c7d172a
--- /dev/null
+++ b/ggml/src/ggml-cuda/dispatch-census.cu
@@ -0,0 +1,130 @@
+#include "dispatch-census.cuh"
+
+#include <cstdio>
+#include <cstdlib>
+#include <ctime>
+#include <map>
+#include <mutex>
+#include <string>
+
+namespace {
+
+struct census_state {
+    std::mutex mutex;
+    FILE * file = nullptr;
+    bool header_written = false;
+    long graph_index = 0;
+    long long graph_t_ns = 0;
+    std::string graph_mode;
+    std::map<std::string, long> rows;
+};
+
+census_state & state() {
+    static census_state s;
+    return s;
+}
+
+const char * census_path() {
+    static const char * path = [] {
+        const char * env = getenv("GGML_CUDA_DISPATCH_CENSUS");
+        return (env != nullptr && env[0] != '\0') ? env : nullptr;
+    }();
+    return path;
+}
+
+long long now_ns() {
+    struct timespec ts;
+    clock_gettime(CLOCK_REALTIME, &ts);
+    return (long long) ts.tv_sec * 1000000000LL + ts.tv_nsec;
+}
+
+void write_header(census_state & s) {
+    if (s.header_written) {
+        return;
+    }
+    fputs("graph_index\tt_ns\tmode\tn_nodes\top\tpath\tdetail\tsrc0_name\tdst_name"
+          "\tsrc0_type\tsrc1_type\tdst_type"
+          "\tne00\tne01\tne02\tne03\tne10\tne11\tne12\tne13"
+          "\tnb01\tnb02\tnb03\tnb11\tnb12\tnb13"
+          "\tsrc0_contiguous\tsrc1_contiguous\tsrc0_transposed\tbatch_count\tlaunches\n", s.file);
+    s.header_written = true;
+}
+
+} // namespace
+
+bool ggml_cuda_dispatch_census_enabled() {
+    return census_path() != nullptr;
+}
+
+void ggml_cuda_dispatch_census_record(const char * path, const char * detail,
+    const ggml_tensor * src0, const ggml_tensor * src1, const ggml_tensor * ids, const ggml_tensor * dst) {
+    if (!ggml_cuda_dispatch_census_enabled()) {
+        return;
+    }
+    char key[1024];
+    snprintf(key, sizeof(key),
+        "%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s"
+        "\t%lld\t%lld\t%lld\t%lld\t%lld\t%lld\t%lld\t%lld"
+        "\t%zu\t%zu\t%zu\t%zu\t%zu\t%zu"
+        "\t%d\t%d\t%d\t%lld",
+        ids != nullptr ? "MUL_MAT_ID" : "MUL_MAT", path, detail != nullptr ? detail : "-",
+        src0->name, dst->name,
+        ggml_type_name(src0->type), ggml_type_name(src1->type), ggml_type_name(dst->type),
+        (long long) src0->ne[0], (long long) src0->ne[1], (long long) src0->ne[2], (long long) src0->ne[3],
+        (long long) src1->ne[0], (long long) src1->ne[1], (long long) src1->ne[2], (long long) src1->ne[3],
+        src0->nb[1], src0->nb[2], src0->nb[3], src1->nb[1], src1->nb[2], src1->nb[3],
+        ggml_is_contiguous(src0) ? 1 : 0, ggml_is_contiguous(src1) ? 1 : 0,
+        ggml_is_transposed(src0) ? 1 : 0, (long long) (src1->ne[2] * src1->ne[3]));
+    census_state & s = state();
+    std::lock_guard<std::mutex> lock(s.mutex);
+    s.rows[key] += 1;
+}
+
+void ggml_cuda_dispatch_census_graph_begin() {
+    if (!ggml_cuda_dispatch_census_enabled()) {
+        return;
+    }
+    census_state & s = state();
+    std::lock_guard<std::mutex> lock(s.mutex);
+    s.graph_t_ns = now_ns();
+    s.graph_mode = "eager";
+    s.rows.clear();
+}
+
+void ggml_cuda_dispatch_census_graph_note(const char * mode) {
+    if (!ggml_cuda_dispatch_census_enabled()) {
+        return;
+    }
+    census_state & s = state();
+    std::lock_guard<std::mutex> lock(s.mutex);
+    s.graph_mode = mode;
+}
+
+void ggml_cuda_dispatch_census_graph_end(int n_nodes) {
+    if (!ggml_cuda_dispatch_census_enabled()) {
+        return;
+    }
+    census_state & s = state();
+    std::lock_guard<std::mutex> lock(s.mutex);
+    if (s.file == nullptr) {
+        s.file = fopen(census_path(), "a");
+        if (s.file == nullptr) {
+            fprintf(stderr, "ggml_cuda_dispatch_census: cannot open %s\n", census_path());
+            return;
+        }
+        write_header(s);
+    }
+    if (s.rows.empty()) {
+        fprintf(s.file, "%ld\t%lld\t%s\t%d\t-\t%s\t-\t-\t-\t-\t-\t-"
+            "\t-\t-\t-\t-\t-\t-\t-\t-\t-\t-\t-\t-\t-\t-\t-\t-\t-\t-\t1\n",
+            s.graph_index, s.graph_t_ns, s.graph_mode.c_str(), n_nodes,
+            s.graph_mode == "replay" ? "graph_replay" : "no_mat_mul");
+    }
+    for (const auto & row : s.rows) {
+        fprintf(s.file, "%ld\t%lld\t%s\t%d\t%s\t%ld\n",
+            s.graph_index, s.graph_t_ns, s.graph_mode.c_str(), n_nodes, row.first.c_str(), row.second);
+    }
+    fflush(s.file);
+    s.graph_index += 1;
+    s.rows.clear();
+}
diff --git a/ggml/src/ggml-cuda/dispatch-census.cuh b/ggml/src/ggml-cuda/dispatch-census.cuh
new file mode 100644
index 000000000..1b72ba304
--- /dev/null
+++ b/ggml/src/ggml-cuda/dispatch-census.cuh
@@ -0,0 +1,18 @@
+#pragma once
+
+#include "common.cuh"
+
+// A default-off census of where each mat-mul launch goes. GGML_CUDA_DISPATCH_CENSUS
+// names a TSV path and enables every hook; unset, each hook costs one load of a
+// static bool. Rows are aggregated inside one graph compute and appended when it
+// ends, one row per distinct (path, detail, src0 name, types, shape, strides)
+// with the launch count, so a decode step and a prefill graph each retain their
+// own population. A CUDA graph replay launches no kernel through these hooks, so
+// the graph compute that replays retains one graph_replay row instead and the
+// captured population is read from the compute that captured it.
+bool ggml_cuda_dispatch_census_enabled();
+void ggml_cuda_dispatch_census_record(const char * path, const char * detail,
+    const ggml_tensor * src0, const ggml_tensor * src1, const ggml_tensor * ids, const ggml_tensor * dst);
+void ggml_cuda_dispatch_census_graph_begin();
+void ggml_cuda_dispatch_census_graph_note(const char * mode);
+void ggml_cuda_dispatch_census_graph_end(int n_nodes);
