         CUBLAS_CHECK(
             cublasSgemm(cublas_h, CUBLAS_OP_T, CUBLAS_OP_N,
                     ne01, ne11, ne10,
@@ -1549,6 +1551,7 @@ static void ggml_cuda_mul_mat_cublas_impl(ggml_backend_cuda_context & ctx, const
                                            (const float *) src1_ptr, s11,
                     (const float *) beta,  (float       *)  dst_ptr, ne0));
     } else if (ne12 == 1 && ne13 == 1) {
+        ggml_cuda_dispatch_census_record("cuBLAS", compute_type == GGML_TYPE_F16 ? "cublasGemmEx/F16" : "cublasGemmEx/BF16", src0, src1, nullptr, dst);
         CUBLAS_CHECK(
             cublasGemmEx(cublas_h, CUBLAS_OP_T, CUBLAS_OP_N,
                     ne01, ne11, ne10,
@@ -1564,6 +1567,7 @@ static void ggml_cuda_mul_mat_cublas_impl(ggml_backend_cuda_context & ctx, const
 
         // there is no broadcast and src0, src1 are contiguous across dims 2, 3
         // use cublasGemmStridedBatchedEx
+        ggml_cuda_dispatch_census_record("cuBLAS", compute_type == GGML_TYPE_F32 ? "cublasGemmStridedBatchedEx/F32" : compute_type == GGML_TYPE_F16 ? "cublasGemmStridedBatchedEx/F16" : "cublasGemmStridedBatchedEx/BF16", src0, src1, nullptr, dst);
         CUBLAS_CHECK(
         cublasGemmStridedBatchedEx(cublas_h, CUBLAS_OP_T, CUBLAS_OP_N,
                 ne01, ne11, ne10,
@@ -1602,6 +1606,7 @@ static void ggml_cuda_mul_mat_cublas_impl(ggml_backend_cuda_context & ctx, const
 
         CUDA_CHECK(cudaGetLastError());
 
+        ggml_cuda_dispatch_census_record("cuBLAS", compute_type == GGML_TYPE_F32 ? "cublasGemmBatchedEx/F32" : compute_type == GGML_TYPE_F16 ? "cublasGemmBatchedEx/F16" : "cublasGemmBatchedEx/BF16", src0, src1, nullptr, dst);
         CUBLAS_CHECK(
         cublasGemmBatchedEx(cublas_h, CUBLAS_OP_T, CUBLAS_OP_N,
                 ne01, ne11, ne10,
@@ -4219,6 +4224,9 @@ static void ggml_cuda_graph_evaluate_and_capture(ggml_backend_cuda_context * cud
             ggml_cuda_graph_update_executable(cuda_ctx, graph_key);
         }
         // Launch graph
+        if (!cuda_graph_update_required) {
+            ggml_cuda_dispatch_census_graph_note("replay");
+        }
         CUDA_CHECK(cudaGraphLaunch(graph->instance, cuda_ctx->stream()));
 #else
         GGML_UNUSED(graph_key);
@@ -4248,6 +4256,7 @@ static enum ggml_status ggml_backend_cuda_graph_compute(ggml_backend_t backend,
     ggml_backend_cuda_context * cuda_ctx = (ggml_backend_cuda_context *) backend->context;
 
     ggml_cuda_set_device(cuda_ctx->device);
+    ggml_cuda_dispatch_census_graph_begin();
 
     bool use_cuda_graph             = false;
     bool cuda_graph_update_required = false;
@@ -4296,9 +4305,11 @@ static enum ggml_status ggml_backend_cuda_graph_compute(ggml_backend_t backend,
         }
 
         CUDA_CHECK(cudaStreamBeginCapture(cuda_ctx->stream(), cudaStreamCaptureModeRelaxed));
