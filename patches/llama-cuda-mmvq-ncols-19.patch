diff --git a/ggml/src/ggml-cuda/mmvq.cuh b/ggml/src/ggml-cuda/mmvq.cuh
index 052ea6f4a..5999b370f 100644
--- a/ggml/src/ggml-cuda/mmvq.cuh
+++ b/ggml/src/ggml-cuda/mmvq.cuh
@@ -11,7 +11,13 @@
 #ifndef GGML_CUDA_ADA_MMVQ_Q8_0_MAX_BATCH_SIZE
 #define GGML_CUDA_ADA_MMVQ_Q8_0_MAX_BATCH_SIZE 8
 #endif
-#define MMVQ_KERNEL_MAX_NCOLS 16
+// The instantiated column counts run 1 to this value. Columns 17 to 19
+// inherit the block geometry of 16 -- nwarps 2 and rows_per_cuda_block 2
+// on the generic table Ada resolves to -- because blocks_per_iter is
+// vdr * nwarps * warp_size / qi and carries no ncols_dst term, so the K
+// loop trip count and the reduction tree are the ones column 16 already
+// runs and the only change is the column extent of tmp and tmp_shared.
+#define MMVQ_KERNEL_MAX_NCOLS 19
 static_assert(GGML_CUDA_ADA_MMVQ_Q6_K_MAX_BATCH_SIZE >= 1 &&
     GGML_CUDA_ADA_MMVQ_Q6_K_MAX_BATCH_SIZE <= MMVQ_KERNEL_MAX_NCOLS,
     "the Q6_K threshold names an instantiated MMVQ column count");
