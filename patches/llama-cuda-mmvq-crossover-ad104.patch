diff --git a/ggml/src/ggml-cuda/mmvq.cuh b/ggml/src/ggml-cuda/mmvq.cuh
index 5605bf7a4..052ea6f4a 100644
--- a/ggml/src/ggml-cuda/mmvq.cuh
+++ b/ggml/src/ggml-cuda/mmvq.cuh
@@ -1,6 +1,23 @@
 #include "common.cuh"
 
 #define MMVQ_MAX_BATCH_SIZE 8 // Max. batch size for which to use MMVQ kernels.
+// The per-type Ada thresholds are build-configurable so a control and a
+// subject differ by one named value; the defaults reproduce the upstream
+// dispatch. The kernel ceiling covers the largest admissible threshold and
+// bounds the instantiated column counts.
+#ifndef GGML_CUDA_ADA_MMVQ_Q6_K_MAX_BATCH_SIZE
+#define GGML_CUDA_ADA_MMVQ_Q6_K_MAX_BATCH_SIZE 8
+#endif
+#ifndef GGML_CUDA_ADA_MMVQ_Q8_0_MAX_BATCH_SIZE
+#define GGML_CUDA_ADA_MMVQ_Q8_0_MAX_BATCH_SIZE 8
+#endif
+#define MMVQ_KERNEL_MAX_NCOLS 16
+static_assert(GGML_CUDA_ADA_MMVQ_Q6_K_MAX_BATCH_SIZE >= 1 &&
+    GGML_CUDA_ADA_MMVQ_Q6_K_MAX_BATCH_SIZE <= MMVQ_KERNEL_MAX_NCOLS,
+    "the Q6_K threshold names an instantiated MMVQ column count");
+static_assert(GGML_CUDA_ADA_MMVQ_Q8_0_MAX_BATCH_SIZE >= 1 &&
+    GGML_CUDA_ADA_MMVQ_Q8_0_MAX_BATCH_SIZE <= MMVQ_KERNEL_MAX_NCOLS,
+    "the Q8_0 threshold names an instantiated MMVQ column count");
 
 bool ggml_cuda_should_use_mmvq(enum ggml_type type, int cc, int64_t ne11);
 
