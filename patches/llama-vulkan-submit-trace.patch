diff --git a/ggml/src/ggml-vulkan/ggml-vulkan-submit-trace.h b/ggml/src/ggml-vulkan/ggml-vulkan-submit-trace.h
new file mode 100644
index 000000000..8d62ac3ce
--- /dev/null
+++ b/ggml/src/ggml-vulkan/ggml-vulkan-submit-trace.h
@@ -0,0 +1,158 @@
+#pragma once
+
+#include <cstdint>
+#include <cstring>
+#include <stdexcept>
+
+// A device that loses its queue reports only that the queue is gone, so the
+// dispatch that failed to retire has to be named from the host side. Each
+// dispatch appends one fixed-size record to this ring, and the device-lost
+// path prints every unretired record beside the last submitted serial and the
+// last serial a fence retired. GGML_VK_SUBMIT_TRACE=1 enables it; every
+// recording site is one load and one branch while it is disabled.
+
+#define GGML_VK_SUBMIT_TRACE_RING_SIZE   256
+#define GGML_VK_SUBMIT_TRACE_NAME_SIZE   64
+#define GGML_VK_SUBMIT_TRACE_BUFFERS     12
+
+static inline bool ggml_vk_parse_submit_trace(const char * value) {
+    if (value == nullptr) {
+        return false;
+    }
+    if (strcmp(value, "1") != 0) {
+        throw std::runtime_error("GGML_VK_SUBMIT_TRACE accepts only the exact value 1");
+    }
+    return true;
+}
+
+struct ggml_vk_submit_record {
+    uint64_t serial;
+    int      node_idx;
+    char     op_name[GGML_VK_SUBMIT_TRACE_NAME_SIZE];
+    char     src0_name[GGML_VK_SUBMIT_TRACE_NAME_SIZE];
+    char     src1_name[GGML_VK_SUBMIT_TRACE_NAME_SIZE];
+    char     dst_name[GGML_VK_SUBMIT_TRACE_NAME_SIZE];
+    char     pipeline_name[GGML_VK_SUBMIT_TRACE_NAME_SIZE];
+    uint32_t grid[3];
+    uint32_t workgroup[3];
+    uint32_t buffer_count;
+    uint64_t buffer_handle[GGML_VK_SUBMIT_TRACE_BUFFERS];
+    uint64_t buffer_offset[GGML_VK_SUBMIT_TRACE_BUFFERS];
+    uint64_t buffer_size[GGML_VK_SUBMIT_TRACE_BUFFERS];
+};
+
+// The name a record carries is a snapshot: a ggml tensor name outlives the
+// dispatch that read it, and the pipeline name outlives the device, but the
+// dump runs after a device loss and copying removes the question.
+static inline void ggml_vk_submit_trace_copy_name(char * destination, const char * source) {
+    if (source == nullptr) {
+        destination[0] = '\0';
+        return;
+    }
+    strncpy(destination, source, GGML_VK_SUBMIT_TRACE_NAME_SIZE - 1);
+    destination[GGML_VK_SUBMIT_TRACE_NAME_SIZE - 1] = '\0';
+}
+
+struct ggml_vk_submit_trace {
+    bool enabled {};
+
+    // The node the graph builder is recording. A dispatch inherits it, since
+    // the dispatch site holds the pipeline and the buffers while the graph
+    // builder holds the operation and the tensors.
+    int         node_idx {-1};
+    const char * op_name {};
+    const char * src0_name {};
+    const char * src1_name {};
+    const char * dst_name {};
+
+    // The serial a dispatch is recorded under. It advances when the batch
+    // reaches the queue, so a record's serial states which submission carries
+    // it and comparing it against the two marks below gives the fence state.
+    uint64_t current_serial {1};
+    uint64_t last_submitted_serial {};
+    uint64_t last_completed_serial {};
+
+    ggml_vk_submit_record ring[GGML_VK_SUBMIT_TRACE_RING_SIZE] {};
+    uint64_t              written {};
+
+    void set_node(int idx, const char * op, const char * src0, const char * src1, const char * dst) {
+        node_idx   = idx;
+        op_name    = op;
+        src0_name  = src0;
+        src1_name  = src1;
+        dst_name   = dst;
+    }
+
+    void record_dispatch(const char * pipeline,
+                         uint32_t grid0, uint32_t grid1, uint32_t grid2,
+                         uint32_t wg0, uint32_t wg1, uint32_t wg2) {
+        ggml_vk_submit_record & record = ring[written % GGML_VK_SUBMIT_TRACE_RING_SIZE];
+        record.serial   = current_serial;
+        record.node_idx = node_idx;
+        ggml_vk_submit_trace_copy_name(record.op_name, op_name);
+        ggml_vk_submit_trace_copy_name(record.src0_name, src0_name);
+        ggml_vk_submit_trace_copy_name(record.src1_name, src1_name);
+        ggml_vk_submit_trace_copy_name(record.dst_name, dst_name);
+        ggml_vk_submit_trace_copy_name(record.pipeline_name, pipeline);
+        record.grid[0] = grid0;
+        record.grid[1] = grid1;
+        record.grid[2] = grid2;
+        record.workgroup[0] = wg0;
+        record.workgroup[1] = wg1;
+        record.workgroup[2] = wg2;
+        record.buffer_count = 0;
+        written++;
+    }
+
+    // A descriptor offset is relative to its VkBuffer, so the handle travels
+    // beside the span and attribution reaches buffer granularity. Correlating a
+    // kernel virtual address needs the allocation base, which lives in the
+    // memory binding rather than here.
+    void record_buffer(uint64_t handle, uint64_t offset, uint64_t size) {
+        if (written == 0) {
+            return;
+        }
+        ggml_vk_submit_record & record = ring[(written - 1) % GGML_VK_SUBMIT_TRACE_RING_SIZE];
+        if (record.buffer_count >= GGML_VK_SUBMIT_TRACE_BUFFERS) {
+            return;
+        }
+        record.buffer_handle[record.buffer_count] = handle;
+        record.buffer_offset[record.buffer_count] = offset;
+        record.buffer_size[record.buffer_count]   = size;
+        record.buffer_count++;
+    }
+
+    void mark_submitted() {
+        last_submitted_serial = current_serial;
+        current_serial++;
+    }
+
+    void mark_completed() {
+        last_completed_serial = last_submitted_serial;
+    }
+
+    // The dump answers what the device was holding, so it prints every record
+    // whose serial no fence has retired, bounded by what the ring still holds.
+    uint64_t unretired_count() const {
+        uint64_t count = 0;
+        while (count < written && count < GGML_VK_SUBMIT_TRACE_RING_SIZE) {
+            const ggml_vk_submit_record & record =
+                ring[(written - count - 1) % GGML_VK_SUBMIT_TRACE_RING_SIZE];
+            if (record.serial <= last_completed_serial) {
+                break;
+            }
+            count++;
+        }
+        return count;
+    }
+
+    const char * fence_state(uint64_t serial) const {
+        if (serial <= last_completed_serial) {
+            return "retired";
+        }
+        if (serial <= last_submitted_serial) {
+            return "submitted";
+        }
+        return "recorded";
+    }
+};
