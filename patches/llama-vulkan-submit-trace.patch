+// The tail of the submission ring names the dispatches the device was holding
+// when it went away. A record at or below the last completed serial retired, so
+// the first record above it bounds the operation that failed to retire.
+static void ggml_vk_print_submit_trace(const vk_device& device) {
+    const ggml_vk_submit_trace & trace = device->submit_trace;
+    if (!trace.enabled || trace.written == 0) {
+        return;
+    }
+
+    const uint64_t count = trace.unretired_count();
+    if (count == 0) {
+        GGML_LOG_ERROR("ggml_vulkan: submission trace holds no unretired dispatch of %llu "
+                "(last submitted serial %llu, last retired serial %llu)\n",
+                (unsigned long long)trace.written,
+                (unsigned long long)trace.last_submitted_serial,
+                (unsigned long long)trace.last_completed_serial);
+        return;
+    }
+
+    GGML_LOG_ERROR("ggml_vulkan: submission trace, %llu unretired of %llu dispatches "
+            "(last submitted serial %llu, last retired serial %llu):\n",
+            (unsigned long long)count, (unsigned long long)trace.written,
+            (unsigned long long)trace.last_submitted_serial,
+            (unsigned long long)trace.last_completed_serial);
+
+    for (uint64_t back = count; back > 0; back--) {
+        const ggml_vk_submit_record & record =
+            trace.ring[(trace.written - back) % GGML_VK_SUBMIT_TRACE_RING_SIZE];
+        GGML_LOG_CONT("  serial %llu node %d: %s (%s) src0=%s src1=%s "
+                "pipeline=%s grid=(%u,%u,%u) workgroup=(%u,%u,%u) fence=%s\n",
+                (unsigned long long)record.serial, record.node_idx,
+                record.dst_name, record.op_name,
+                record.src0_name, record.src1_name,
+                record.pipeline_name,
+                record.grid[0], record.grid[1], record.grid[2],
+                record.workgroup[0], record.workgroup[1], record.workgroup[2],
+                trace.fence_state(record.serial));
+        for (uint32_t i = 0; i < record.buffer_count; i++) {
+            GGML_LOG_CONT("      buffer %u: handle=0x%llx offset=0x%llx size=0x%llx\n", i,
+                    (unsigned long long)record.buffer_handle[i],
+                    (unsigned long long)record.buffer_offset[i],
+                    (unsigned long long)record.buffer_size[i]);
+        }
+    }
+}
+
