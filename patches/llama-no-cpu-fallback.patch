+static bool graph_node_has_backend_work(const ggml_tensor * node) {
+    switch (node->op) {
+        case GGML_OP_NONE:
+        case GGML_OP_RESHAPE:
+        case GGML_OP_VIEW:
+        case GGML_OP_PERMUTE:
+        case GGML_OP_TRANSPOSE:
+            return false;
+        default:
+            return true;
+    }
+}
+
+static bool graph_uses_cpu_backend(ggml_backend_sched_t sched, ggml_cgraph * graph) {
+    if (!getenv("LLAMA_NO_CPU_FALLBACK")) {
+        return false;
+    }
+
+    for (int node_index = 0; node_index < ggml_graph_n_nodes(graph); ++node_index) {
+        ggml_tensor * node = ggml_graph_node(graph, node_index);
+        if (!graph_node_has_backend_work(node)) {
+            continue;
+        }
+        ggml_backend_t backend = ggml_backend_sched_get_tensor_backend(sched, node);
+        ggml_backend_dev_t device = backend ? ggml_backend_get_device(backend) : nullptr;
+        if (device && ggml_backend_dev_type(device) == GGML_BACKEND_DEVICE_TYPE_CPU) {
+            LLAMA_LOG_ERROR("CPU fallback rejected for graph node %s (%s)\n", node->name, ggml_op_name(node->op));
+            return true;
+        }
+    }
+
+    return false;
+}
