diff --git a/ggml/src/ggml-vulkan/ggml-vulkan-submit-limit.h b/ggml/src/ggml-vulkan/ggml-vulkan-submit-limit.h
new file mode 100644
index 0000000..419bb40
--- /dev/null
+++ b/ggml/src/ggml-vulkan/ggml-vulkan-submit-limit.h
@@ -0,0 +1,31 @@
+#pragma once
+
+#include <cstdint>
+#include <limits>
+#include <stdexcept>
+
+static inline uint32_t ggml_vk_parse_max_nodes_per_submit(
+        const char * value, uint32_t default_value) {
+    if (value == nullptr) {
+        return default_value;
+    }
+    if (*value == '\0') {
+        throw std::runtime_error("GGML_VK_MAX_NODES_PER_SUBMIT must be a positive decimal integer");
+    }
+
+    uint32_t result = 0;
+    for (const char * cursor = value; *cursor != '\0'; ++cursor) {
+        if (*cursor < '0' || *cursor > '9') {
+            throw std::runtime_error("GGML_VK_MAX_NODES_PER_SUBMIT must be a positive decimal integer");
+        }
+        const uint32_t digit = static_cast<uint32_t>(*cursor - '0');
+        if (result > (std::numeric_limits<uint32_t>::max() - digit) / 10) {
+            throw std::runtime_error("GGML_VK_MAX_NODES_PER_SUBMIT exceeds uint32_t");
+        }
+        result = result * 10 + digit;
+    }
+    if (result == 0) {
+        throw std::runtime_error("GGML_VK_MAX_NODES_PER_SUBMIT must be a positive decimal integer");
+    }
+    return result;
+}
