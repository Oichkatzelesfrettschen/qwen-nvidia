diff --git a/ggml/src/ggml-vulkan/ggml-vulkan-pacing.h b/ggml/src/ggml-vulkan/ggml-vulkan-pacing.h
new file mode 100644
index 0000000..abfcb3a
--- /dev/null
+++ b/ggml/src/ggml-vulkan/ggml-vulkan-pacing.h
@@ -0,0 +1,49 @@
+#pragma once
+
+#include <cstdint>
+#include <limits>
+#include <stdexcept>
+
+static inline uint32_t ggml_vk_parse_duty_cycle_percent(const char * value) {
+    if (value == nullptr) {
+        return 100;
+    }
+    if (*value == '\0') {
+        throw std::runtime_error("GGML_VK_DUTY_CYCLE_PERCENT must be an integer from 1 through 100");
+    }
+
+    uint32_t result = 0;
+    for (const char * cursor = value; *cursor != '\0'; ++cursor) {
+        if (*cursor < '0' || *cursor > '9') {
+            throw std::runtime_error("GGML_VK_DUTY_CYCLE_PERCENT must be an integer from 1 through 100");
+        }
+        result = result * 10 + static_cast<uint32_t>(*cursor - '0');
+        if (result > 100) {
+            throw std::runtime_error("GGML_VK_DUTY_CYCLE_PERCENT must be an integer from 1 through 100");
+        }
+    }
+
+    if (result == 0) {
+        throw std::runtime_error("GGML_VK_DUTY_CYCLE_PERCENT must be an integer from 1 through 100");
+    }
+    return result;
+}
+
+static inline uint64_t ggml_vk_pacing_idle_us(uint64_t active_us, uint32_t duty_cycle_percent) {
+    if (duty_cycle_percent == 0 || duty_cycle_percent > 100) {
+        throw std::invalid_argument("Vulkan duty cycle must be from 1 through 100");
+    }
+    if (active_us == 0 || duty_cycle_percent == 100) {
+        return 0;
+    }
+
+    const uint64_t idle_percent = 100 - duty_cycle_percent;
+    const uint64_t whole = active_us / duty_cycle_percent;
+    const uint64_t remainder = active_us % duty_cycle_percent;
+    if (whole > std::numeric_limits<uint64_t>::max() / idle_percent) {
+        return std::numeric_limits<uint64_t>::max();
+    }
+
+    return whole * idle_percent +
+        (remainder * idle_percent + duty_cycle_percent - 1) / duty_cycle_percent;
+}
