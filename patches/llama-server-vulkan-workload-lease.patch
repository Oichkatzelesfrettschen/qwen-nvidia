     int64_t t_last_load_progress_ms = 0;
 
+    // The descriptor is opened once and reused, since init() runs again when
+    // handle_sleeping_state wakes the server. O_CLOEXEC keeps it out of
+    // anything the process spawns, so only this server's own flock state
+    // decides the lease. A named path that cannot be opened fails the launch,
+    // because a server that silently skipped the lease would run graphs beside
+    // a generation while every log line said the invariant held.
+    bool workload_lease_open() {
+#if defined(__unix__) || (defined(__APPLE__) && defined(__MACH__))
+        if (workload_lease_descriptor >= 0) {
+            return true;
+        }
+
+        // QWEN_GPU_COMPUTE_LEASE is the name; QWEN_VULKAN_WORKLOAD_LOCK is read
+        // beside it for one transition release, and
+        // scripts/qwen-capacity-policy.sh exports both over one file.
+        const char * path = getenv("QWEN_GPU_COMPUTE_LEASE");
+        if (path == nullptr || path[0] == '\0') {
+            path = getenv("QWEN_VULKAN_WORKLOAD_LOCK");
+        }
+        if (path == nullptr || path[0] == '\0') {
+            return true;
+        }
+
+        const int descriptor = open(path, O_RDWR | O_CREAT | O_CLOEXEC, 0644);
+        if (descriptor < 0) {
+            SRV_ERR("vulkan workload lease open failed: path=%s reason=%s\n", path, strerror(errno));
+            return false;
+        }
+
+        workload_lease_descriptor = descriptor;
+        workload_lease_path       = path;
+
+        SRV_INF("vulkan workload lease armed: path=%s\n", workload_lease_path.c_str());
+#endif
+        return true;
+    }
+
+    // QWEN_GPU_COMPUTE_LEASE_WAIT_S names the load path's deadline in seconds
+    // the way image-service.py names its own with QWEN_IMAGE_LEASE_WAIT_S, 300
+    // by default and 0 for one non-blocking attempt. A value outside 0 to 86400
+    // is refused by name with the default used in its place.
+    int workload_lease_wait_seconds() const {
+        const char * configured = getenv("QWEN_GPU_COMPUTE_LEASE_WAIT_S");
+        if (configured != nullptr && configured[0] != '\0') {
+            char *     end   = nullptr;
+            const long value = strtol(configured, &end, 10);
+            if (end != nullptr && *end == '\0' && value >= 0 && value <= 86400) {
+                return (int) value;
+            }
+            SRV_WRN("vulkan workload lease wait is not a second count: value=%s using=300\n",
+                    configured);
+        }
+        return 300;
+    }
+
+    // The bound belongs to the caller rather than to the lease. A model load
+    // has a caller that carries a refusal -- load_model returns false and the
+    // launch ends -- so it waits under a deadline, because the owner lock above
+    // this one refuses at once with status 75 and an unbounded acquire beneath
+    // it would turn that refusal into a stall.
+    //
+    // Polling bounds the wait; it buys no cancellation. server_queue keeps its
+    // running flag private with no accessor, and server.cpp's is_terminating is
+    // file static, so nothing here reads the termination this loop would have to
+    // check. The step is bounded at 50 ms and the deadline ends it.
+    bool workload_lease_acquire_bounded() {
+#if defined(__unix__) || (defined(__APPLE__) && defined(__MACH__))
+        if (workload_lease_descriptor < 0 || workload_lease_held) {
+            return true;
+        }
+
+        int64_t   waited_ms = 0;
+        const int wait_s    = workload_lease_wait_seconds();
+
+        if (flock(workload_lease_descriptor, LOCK_EX | LOCK_NB) != 0) {
+            if (errno != EWOULDBLOCK && errno != EAGAIN) {
+                SRV_ERR("vulkan workload lease failed: path=%s reason=%s\n",
+                        workload_lease_path.c_str(), strerror(errno));
+                return false;
+            }
+
+            SRV_INF("vulkan workload lease waiting: path=%s deadline_s=%d\n",
+                    workload_lease_path.c_str(), wait_s);
+
+            const int64_t t_start    = ggml_time_us();
+            const int64_t deadline   = t_start + (int64_t) wait_s * 1000000;
+            bool          took_lease = false;
+
+            while (ggml_time_us() < deadline) {
+                if (flock(workload_lease_descriptor, LOCK_EX | LOCK_NB) == 0) {
+                    took_lease = true;
+                    break;
+                }
+                if (errno != EWOULDBLOCK && errno != EAGAIN) {
+                    SRV_ERR("vulkan workload lease failed: path=%s reason=%s\n",
+                            workload_lease_path.c_str(), strerror(errno));
+                    return false;
+                }
+                std::this_thread::sleep_for(std::chrono::milliseconds(50));
+            }
+
+            waited_ms = (ggml_time_us() - t_start) / 1000;
+
+            if (!took_lease) {
+                SRV_WRN("vulkan workload lease deadline reached without the lease: path=%s waited_ms=%" PRId64 " deadline_s=%d\n",
+                        workload_lease_path.c_str(), waited_ms, wait_s);
+                return false;
+            }
+        }
+
+        workload_lease_held = true;
+
+        SRV_INF("vulkan workload lease acquired: path=%s waited_ms=%" PRId64 " bound=deadline\n",
+                workload_lease_path.c_str(), waited_ms);
+#endif
+        return true;
+    }
+
+    // A non-blocking attempt runs first so the waiting line reaches the log
+    // before the block rather than after it, which is what makes a stall
+    // visible while it lasts.
+    // Returns true when this pass may submit graphs: the lease is held, or no
+    // lease is configured. Every failure returns false so the caller leaves
+    // the pass without posting NEXT_RESPONSE, because a pass that submits
+    // without the lease is the one state the lease exists to exclude.
+    //
+    // This one blocks rather than taking a deadline, because update_slots owns
+    // no way to reschedule a pass it abandons: server_queue::start_loop
+    // re-enters callback_update_slots only when a task arrives or the process
+    // terminates, so a pass that gave up on the lease would strand its request
+    // until unrelated traffic woke the loop. A chat turn waiting behind an
+    // image generation is what the lease is for. server.cpp registers SIGINT
+    // and SIGTERM with sa_flags = 0, so no SA_RESTART covers the block and a
+    // terminating signal returns EINTR, which is the cancellation the bounded
+    // acquire above cannot reach.
+    bool workload_lease_acquire() {
+#if defined(__unix__) || (defined(__APPLE__) && defined(__MACH__))
+        if (workload_lease_descriptor < 0 || workload_lease_held) {
+            return true;
+        }
+
+        int64_t waited_ms = 0;
+
+        if (flock(workload_lease_descriptor, LOCK_EX | LOCK_NB) != 0) {
+            if (errno != EWOULDBLOCK && errno != EAGAIN) {
+                SRV_ERR("vulkan workload lease failed: path=%s reason=%s\n",
+                        workload_lease_path.c_str(), strerror(errno));
+                return false;
+            }
+
+            SRV_INF("vulkan workload lease waiting: path=%s\n", workload_lease_path.c_str());
+
+            const int64_t t_start = ggml_time_us();
+            const int     result  = flock(workload_lease_descriptor, LOCK_EX);
+            waited_ms = (ggml_time_us() - t_start) / 1000;
+
+            if (result != 0) {
+                // server.cpp registers SIGINT and SIGTERM with sa_flags = 0, so
+                // a terminating signal returns EINTR here. The caller leaves
+                // the pass without submitting, which lets the task queue
+                // observe the termination it was told about; any other errno
+                // is a lock the kernel refused, and the pass is refused with
+                // it rather than run beside the holder.
+                SRV_WRN("vulkan workload lease wait ended without the lease: path=%s waited_ms=%" PRId64 " reason=%s\n",
+                        workload_lease_path.c_str(), waited_ms, strerror(errno));
+                return false;
+            }
+        }
+
+        workload_lease_held = true;
+
+        SRV_INF("vulkan workload lease acquired: path=%s waited_ms=%" PRId64 "\n",
+                workload_lease_path.c_str(), waited_ms);
+#endif
+        return true;
+    }
+
+    void workload_lease_release() {
+#if defined(__unix__) || (defined(__APPLE__) && defined(__MACH__))
+        if (workload_lease_descriptor < 0 || !workload_lease_held) {
+            return;
+        }
+
+        if (flock(workload_lease_descriptor, LOCK_UN) != 0) {
+            SRV_ERR("vulkan workload lease release failed: path=%s reason=%s\n",
+                    workload_lease_path.c_str(), strerror(errno));
+        }
+
+        workload_lease_held = false;
+
+        SRV_INF("vulkan workload lease released: path=%s\n", workload_lease_path.c_str());
+#endif
+    }
+
     void destroy() {
+        // A sleeping server frees the context and executes nothing, so the
+        // lease goes back before the model does.
+        workload_lease_release();
+
         spec.reset();
         spec_init.reset();
 
