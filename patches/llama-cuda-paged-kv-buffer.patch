+#if defined(GGML_USE_VMM)
+static ggml_backend_buffer_t ggml_backend_cuda_paged_kv_alloc_buffer(ggml_backend_buffer_type_t buft, size_t size) {
+    ggml_backend_cuda_buffer_type_context * buft_ctx = (ggml_backend_cuda_buffer_type_context *) buft->context;
+    const int device = buft_ctx->device;
+    const ggml_cuda_device_info::cuda_device_info & device_info = ggml_cuda_info().devices[device];
+
+    if (!device_info.vmm) {
+        GGML_LOG_ERROR("%s: device %d reports no virtual memory management support\n", __func__, device);
+        return nullptr;
+    }
+
+    ggml_cuda_set_device(device);
+
+    const size_t unit = device_info.vmm_granularity_minimum;
+    GGML_ASSERT(unit > 0);
+    const size_t virtual_bytes = GGML_PAD(size, unit);
+
+    ggml_backend_cuda_buffer_context * ctx = new ggml_backend_cuda_buffer_context(device, nullptr);
+    ctx->kind = GGML_CUDA_BUFFER_KIND_KV_VMM;
+    ctx->vmm_unit_bytes = unit;
+
+    if (virtual_bytes > 0) {
+        const int physical_device = ggml_cuda_get_physical_device(device);
+        CUdeviceptr address = 0;
+        CUresult result = cuMemAddressReserve(&address, virtual_bytes, unit, 0, 0);
+        if (result != CUDA_SUCCESS) {
+            const char * error_name = nullptr;
+            cuGetErrorName(result, &error_name);
+            GGML_LOG_ERROR("%s: reserving %zu bytes of virtual address space on device %d failed: %s\n",
+                           __func__, virtual_bytes, device, error_name ? error_name : "unknown");
+            delete ctx;
+            return nullptr;
+        }
+        ctx->dev_ptr = (void *) address;
+        ctx->vmm_virtual_reserved_bytes = virtual_bytes;
+        ctx->vmm_units.resize(virtual_bytes / unit);
+
+        CUmemAllocationProp prop = {};
+        prop.type = CU_MEM_ALLOCATION_TYPE_PINNED;
+        prop.location.type = CU_MEM_LOCATION_TYPE_DEVICE;
+        prop.location.id = physical_device;
+        CUmemAccessDesc access = {};
+        access.location.type = CU_MEM_LOCATION_TYPE_DEVICE;
+        access.location.id = physical_device;
+        access.flags = CU_MEM_ACCESS_FLAGS_PROT_READWRITE;
+
+        // Each unit is a transaction of its own: create, map, grant access.
+        // A failure at any step returns the allocation failure to the caller
+        // the way cudaMalloc's path does, and the destructor unwinds every
+        // unit created so far -- unmapping what was mapped, releasing every
+        // handle, then freeing the reservation -- so a failed unit leaves no
+        // handle behind. The KV constructor turns a null buffer into a named
+        // exception, where an abort here would end the server.
+        for (size_t i = 0; i < ctx->vmm_units.size(); ++i) {
+            ggml_backend_cuda_vmm_unit & vmm_unit = ctx->vmm_units[i];
+            const CUdeviceptr unit_address = address + i*unit;
+            result = cuMemCreate(&vmm_unit.handle, unit, &prop, 0);
+            if (result != CUDA_SUCCESS) {
+                const char * error_name = nullptr;
+                cuGetErrorName(result, &error_name);
+                GGML_LOG_ERROR("%s: creating unit %zu of %zu (%zu bytes) on device %d failed: %s\n",
+                               __func__, i, ctx->vmm_units.size(), unit, device, error_name ? error_name : "unknown");
+                vmm_unit.handle = 0;
+                delete ctx;
+                return nullptr;
+            }
+            ctx->vmm_physical_allocated_bytes += unit;
+            result = cuMemMap(unit_address, unit, 0, vmm_unit.handle, 0);
+            if (result != CUDA_SUCCESS) {
+                const char * error_name = nullptr;
+                cuGetErrorName(result, &error_name);
+                GGML_LOG_ERROR("%s: mapping unit %zu of %zu on device %d failed: %s\n",
+                               __func__, i, ctx->vmm_units.size(), device, error_name ? error_name : "unknown");
+                delete ctx;
+                return nullptr;
+            }
+            vmm_unit.mapped = true;
+            ctx->vmm_physical_mapped_bytes += unit;
+            // A mapping grants nothing by itself; access is set per unit so a
+            // later commit of one unit follows the same three steps.
+            result = cuMemSetAccess(unit_address, unit, &access, 1);
+            if (result != CUDA_SUCCESS) {
+                const char * error_name = nullptr;
+                cuGetErrorName(result, &error_name);
+                GGML_LOG_ERROR("%s: granting device %d access to unit %zu of %zu failed: %s\n",
+                               __func__, device, i, ctx->vmm_units.size(), error_name ? error_name : "unknown");
+                delete ctx;
+                return nullptr;
+            }
