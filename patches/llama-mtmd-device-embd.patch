+// The embedding handoff trace digests the bytes the graph consumes as its
+// embedding input, per ubatch, under LLAMA_EMBD_HANDOFF_TRACE=1: the host
+// path digests the bytes it uploads and the device path reads its view back
+// for the digest alone, so a control and a subject arm are compared on the
+// tensor the forward pass reads rather than on where it came from. The
+// read-back is diagnostic and absent when the variable is unset.
+static bool llm_graph_embd_handoff_trace() {
+    static const bool enabled = [] {
+        const char * value = getenv("LLAMA_EMBD_HANDOFF_TRACE");
+        return value && strcmp(value, "1") == 0;
+    }();
+    return enabled;
+}
+
+static uint64_t llm_graph_fnv1a64(const void * data, size_t n) {
+    const uint8_t * p = (const uint8_t *) data;
+    uint64_t h = 1469598103934665603ULL;
+    for (size_t i = 0; i < n; ++i) {
+        h ^= p[i];
+        h *= 1099511628211ULL;
+    }
+    return h;
+}
+
+static void llm_graph_embd_handoff_log(const char * source, ggml_tensor * embd, int64_t n_tokens, int64_t n_embd,
+        int64_t offset, const void * host_bytes) {
+    const size_t nbytes = (size_t) n_tokens*n_embd*ggml_element_size(embd);
+    std::vector<uint8_t> readback;
+    if (!host_bytes) {
+        readback.resize(nbytes);
+        ggml_backend_tensor_get(embd, readback.data(), 0, nbytes);
+        host_bytes = readback.data();
+    }
+    // rowchain digests the sequence of per-row digests, so a reader holding
+    // the projector's per-row digests recomputes the value for any row range
+    // and checks that this ubatch read exactly those rows in that order
+    const size_t row_bytes = (size_t) n_embd*ggml_element_size(embd);
+    uint64_t rowchain = 1469598103934665603ULL;
+    for (int64_t row = 0; row < n_tokens; ++row) {
+        const uint64_t row_digest = llm_graph_fnv1a64((const uint8_t *) host_bytes + (size_t) row*row_bytes, row_bytes);
+        rowchain = llm_graph_fnv1a64(&row_digest, sizeof(row_digest)) ^ (rowchain*1099511628211ULL);
+    }
+    ggml_backend_buffer_t buffer = embd->view_src ? embd->view_src->buffer : embd->buffer;
+    LLAMA_LOG_INFO("embd_handoff source=%s n_tokens=%" PRId64 " n_embd=%" PRId64 " offset=%" PRId64 " buffer=%s digest=%016" PRIx64 " rowchain=%016" PRIx64 "\n",
+            source, n_tokens, n_embd, offset, buffer ? ggml_backend_buffer_name(buffer) : "none",
+            llm_graph_fnv1a64(host_bytes, nbytes), rowchain);
+}
