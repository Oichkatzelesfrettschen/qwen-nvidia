+    const ggml_tensor * t = batch->embd_dev;
+    LOG_INF("mtmd_embd_batch serial=%" PRIu64 " mode=%s n_entries=%zu n_tokens=%d tensor=%s data=%p buffer=%s\n",
+            serial, mode, batch->entries.size(), batch->n_tokens(),
+            t ? ggml_get_name(t) : "host", t ? t->data : nullptr,
+            t && t->buffer ? ggml_backend_buffer_name(t->buffer) : "host");
+    int64_t row_offset = 0;
+    for (size_t i = 0; i < batch->entries.size(); ++i) {
+        const mtmd_input_chunk * c = batch->entries[i];
+        const int64_t n_tokens = (int64_t) mtmd_input_chunk_get_n_tokens(c);
+        const char * image_id = mtmd_input_chunk_get_id(c);
+        LOG_INF("mtmd_embd_entry serial=%" PRIu64 " entry=%zu image=%s row_offset=%" PRId64 " n_tokens=%" PRId64 "\n",
+                serial, i, image_id && *image_id ? image_id : "-", row_offset, n_tokens);
+        row_offset += n_tokens;
+    }
+}
+
+bool mtmd_batch_output_is_device(const mtmd_batch * batch) {
+    return batch->embd_dev != nullptr && batch->embd_dev_buf != nullptr;
+}
+
+ggml_tensor * mtmd_batch_get_output_embd_device(mtmd_batch * batch, const mtmd_input_chunk * chunk, int64_t * row_offset) {
+    if (!mtmd_batch_output_is_device(batch)) {
+        LOG_ERR("%s: batch holds no device output\n", __func__);
+        return nullptr;
+    }
+    int64_t offset = 0;
+    for (const auto * c : batch->entries) {
+        const int64_t n_tokens = (int64_t) mtmd_input_chunk_get_n_tokens(c);
+        GGML_ASSERT(offset + n_tokens <= batch->embd_dev->ne[1]);
+        if (c == chunk) {
+            *row_offset = offset;
+            return batch->embd_dev;
+        }
+        offset += n_tokens;
+    }
+    return nullptr; // not found
+}
