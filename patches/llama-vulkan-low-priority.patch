+#if defined(VK_KHR_global_priority)
+static bool ggml_vk_queue_family_supports_global_priority(
+        const vk::PhysicalDevice & physical_device,
+        uint32_t                   queue_family_index,
+        VkQueueGlobalPriorityKHR   requested_priority) {
+    uint32_t queue_family_count = 0;
+    vkGetPhysicalDeviceQueueFamilyProperties2(physical_device, &queue_family_count, nullptr);
+    if (queue_family_index >= queue_family_count) {
+        return false;
+    }
+
+    std::vector<VkQueueFamilyProperties2> queue_family_properties(queue_family_count);
+    std::vector<VkQueueFamilyGlobalPriorityPropertiesKHR> global_priority_properties(queue_family_count);
+    for (uint32_t family_index = 0; family_index < queue_family_count; ++family_index) {
+        queue_family_properties[family_index].sType = VK_STRUCTURE_TYPE_QUEUE_FAMILY_PROPERTIES_2;
+        queue_family_properties[family_index].pNext = &global_priority_properties[family_index];
+        global_priority_properties[family_index].sType = VK_STRUCTURE_TYPE_QUEUE_FAMILY_GLOBAL_PRIORITY_PROPERTIES_KHR;
+    }
+    vkGetPhysicalDeviceQueueFamilyProperties2(physical_device, &queue_family_count, queue_family_properties.data());
+
+    const auto & priorities = global_priority_properties[queue_family_index];
+    for (uint32_t priority_index = 0; priority_index < priorities.priorityCount; ++priority_index) {
+        if (priorities.priorities[priority_index] == requested_priority) {
+            return true;
+        }
+    }
+
+    return false;
+}
+#endif
