{
  "mcpServers": {
    "web": {
      "command": "python3",
      "timeout_ms": 30000,
      "args": [
        "$HOME/qwen-laptop-setup/remote/web-mcp/server.py",
        "--provider",
        "fake"
      ],
      "env": {
        "QWEN_WEB_PROFILE": "web-balanced-admission",
        "QWEN_WEB_PROVIDER": "fake",
        "QWEN_WEB_MAX_RESULTS": "3",
        "QWEN_WEB_MAX_FETCHES_PER_SEARCH": "1",
        "QWEN_WEB_MAX_CHARS_PER_FETCH": "12000",
        "QWEN_WEB_SEARCH_AUTH": "required",
        "QWEN_WEB_FAKE_FIXTURES": "$HOME/qwen-laptop-setup/remote/test-fixtures/web-fake-provider.json",
        "QWEN_WEB_TOKEN_KEY_FILE": "$HOME/qwen-webui-state/web-admission-router-i/keys/token.key",
        "QWEN_WEB_STATE_DIR": "$HOME/qwen-webui-state/web-admission-router-i/web-mcp"
      }
    }
  }
}
