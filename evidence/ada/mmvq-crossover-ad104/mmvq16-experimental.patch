Experimental extension over the applied llama-cuda-mmvq-crossover-ad104.patch:
raise the instantiated MMVQ kernel ceiling from twelve to sixteen columns so
the Q8_0 threshold can be tested at B13-B16 while Q4_K, Q5_K, and Q6_K keep
their promoted dispatch. Local to the experiment; never enters patches/.

--- a/ggml/src/ggml-cuda/mmvq.cuh
+++ b/ggml/src/ggml-cuda/mmvq.cuh
@@ -12,7 +12,7 @@
 #ifndef GGML_CUDA_ADA_MMVQ_Q8_0_MAX_BATCH_SIZE
 #define GGML_CUDA_ADA_MMVQ_Q8_0_MAX_BATCH_SIZE 8
 #endif
-#define MMVQ_KERNEL_MAX_NCOLS 12
+#define MMVQ_KERNEL_MAX_NCOLS 16
 static_assert(GGML_CUDA_ADA_MMVQ_Q6_K_MAX_BATCH_SIZE >= 1 &&
     GGML_CUDA_ADA_MMVQ_Q6_K_MAX_BATCH_SIZE <= MMVQ_KERNEL_MAX_NCOLS,
     "the Q6_K threshold names an instantiated MMVQ column count");
--- a/ggml/src/ggml-cuda/mmvq.cu
+++ b/ggml/src/ggml-cuda/mmvq.cu
@@ -418,6 +418,10 @@ static constexpr __host__ __device__ int calc_nwarps(ggml_type type, int ncols_d
             case 10:
             case 11:
             case 12:
+            case 13:
+            case 14:
+            case 15:
+            case 16:
                 return 2;
             default:
                 return 1;
@@ -549,6 +553,10 @@ static constexpr __host__ __device__ int calc_rows_per_block(int ncols_dst, int
             case 10:
             case 11:
             case 12:
+            case 13:
+            case 14:
+            case 15:
+            case 16:
                 return 2;
             default:
                 return 1;
@@ -1132,6 +1140,38 @@ static void mul_mat_vec_q_switch_ncols_dst(
                  sample_ratio_fd, stride_sample_x, stride_sample_y, stride_sample_dst,
                  dims.first, dims.second, 0, ids_stride, stream);
         } break;
+        case 13: {
+            constexpr int c_ncols_dst = 13;
+            std::pair<dim3, dim3> dims = calc_launch_params<type>(c_ncols_dst, nrows_x, nchannels_dst, nsamples_dst, warp_size, table_id);
+            mul_mat_vec_q_switch_fusion<type, c_ncols_dst>(vx, vy, ids, fusion, dst, ncols_x, nchannels_y_fd, stride_row_x, stride_col_y, stride_col_dst,
+                 channel_ratio_fd, stride_channel_x, stride_channel_y, stride_channel_dst,
+                 sample_ratio_fd, stride_sample_x, stride_sample_y, stride_sample_dst,
+                 dims.first, dims.second, 0, ids_stride, stream);
+        } break;
+        case 14: {
+            constexpr int c_ncols_dst = 14;
+            std::pair<dim3, dim3> dims = calc_launch_params<type>(c_ncols_dst, nrows_x, nchannels_dst, nsamples_dst, warp_size, table_id);
+            mul_mat_vec_q_switch_fusion<type, c_ncols_dst>(vx, vy, ids, fusion, dst, ncols_x, nchannels_y_fd, stride_row_x, stride_col_y, stride_col_dst,
+                 channel_ratio_fd, stride_channel_x, stride_channel_y, stride_channel_dst,
+                 sample_ratio_fd, stride_sample_x, stride_sample_y, stride_sample_dst,
+                 dims.first, dims.second, 0, ids_stride, stream);
+        } break;
+        case 15: {
+            constexpr int c_ncols_dst = 15;
+            std::pair<dim3, dim3> dims = calc_launch_params<type>(c_ncols_dst, nrows_x, nchannels_dst, nsamples_dst, warp_size, table_id);
+            mul_mat_vec_q_switch_fusion<type, c_ncols_dst>(vx, vy, ids, fusion, dst, ncols_x, nchannels_y_fd, stride_row_x, stride_col_y, stride_col_dst,
+                 channel_ratio_fd, stride_channel_x, stride_channel_y, stride_channel_dst,
+                 sample_ratio_fd, stride_sample_x, stride_sample_y, stride_sample_dst,
+                 dims.first, dims.second, 0, ids_stride, stream);
+        } break;
+        case 16: {
+            constexpr int c_ncols_dst = 16;
+            std::pair<dim3, dim3> dims = calc_launch_params<type>(c_ncols_dst, nrows_x, nchannels_dst, nsamples_dst, warp_size, table_id);
+            mul_mat_vec_q_switch_fusion<type, c_ncols_dst>(vx, vy, ids, fusion, dst, ncols_x, nchannels_y_fd, stride_row_x, stride_col_y, stride_col_dst,
+                 channel_ratio_fd, stride_channel_x, stride_channel_y, stride_channel_dst,
+                 sample_ratio_fd, stride_sample_x, stride_sample_y, stride_sample_dst,
+                 dims.first, dims.second, 0, ids_stride, stream);
+        } break;
         default:
             GGML_ABORT("fatal error");
             break;
