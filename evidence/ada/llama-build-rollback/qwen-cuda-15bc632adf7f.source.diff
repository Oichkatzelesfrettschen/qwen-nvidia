+// The tail of the submission ring names the dispatches the device was holding
+// when it went away. A record at or below the last completed serial retired, so
+// the first record above it bounds the operation that failed to retire.
+static void ggml_vk_print_submit_trace(const vk_device& device) {
+    const ggml_vk_submit_trace & trace = device->submit_trace;
+    if (!trace.enabled || trace.written == 0) {
+        return;
+    }
+
