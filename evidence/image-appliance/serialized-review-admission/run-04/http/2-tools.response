[{"display_name":"image_generate_image","tool":"image_generate_image","type":"mcp","permissions":{"write":false},"uses_cwd":false,"definition":{"type":"function","function":{"name":"image_generate_image","description":"Generate one image under the image-sdxs-512-a image profile, which renders 512x512 and admits at most 512 pixels a side and 4 sampler steps. The call runs only under a grant the user approved for these exact arguments, and the reply names the artifact digest and its provenance URL.","parameters":{"type":"object","additionalProperties":false,"properties":{"prompt":{"type":"string","description":"The approved prompt, at most 2000 characters."},"negative_prompt":{"type":"string","description":"The approved negative prompt, empty when the approval named none."},"seed":{"type":"integer","minimum":0,"maximum":18446744073709551615,"description":"The seed the approval displayed. The runtime chooses none."},"width":{"type":"integer","minimum":64,"maximum":512,"default":512,"description":"Pixel width. The image-sdxs-512-a profile renders 512 natively and admits at most 512."},"height":{"type":"integer","minimum":64,"maximum":512,"default":512,"description":"Pixel height. The image-sdxs-512-a profile renders 512 natively and admits at most 512."},"steps":{"type":"integer","minimum":1,"maximum":4,"default":1,"description":"Sampler steps. The image-sdxs-512-a profile runs 1 and admits at most 4."},"profile_id":{"type":"string","enum":["image-sdxs-512-a"],"description":"The image profile this server serves. image-sdxs-512-a is the one profile it admits, and the grant names the same one."},"authorization":{"type":"string","description":"The single-use grant the user's approval issued for these exact arguments."}},"required":["prompt","seed","width","height","steps","profile_id","authorization"]}}}}]