__pycache__/
*.py[cod]
*.part
*.tmp
/build*/
/models/
!evidence/*.log
!evidence/**/*.log
api.key
*.key
# Private hardware captures carry DIMM serials and SMBIOS identifiers. The
# sanitized findings and artifact hashes live in the tracked evidence documents.
/evidence/*-memory-configuration/
VP_VULKANINFO_*.json

# Vendor SDK extracts are fetched rather than tracked.
/cusparselt/

# Two speculation sweeps ran while their own runner was being edited, and sh
# reads a script incrementally, so the arms after the edit ran under different
# code than the arms before it. The completed runs live beside them under
# evidence/ada/speculation-target-*/.
/evidence/ada/speculation-2b-target/
/evidence/ada/speculation-4b-target/

# Raw profiler reports carry the capturing process's whole environment:
# Nsight Systems records every exported variable into TARGET_INFO_SYSTEM_ENV,
# and the sqlite export carries it forward. The retained form is the derived
# CSV/TSV beside the report's SHA-256, and
# scripts/exec-profiler-clean-env.sh bounds what a capture can absorb.
*.nsys-rep
*.ncu-rep
*.qdrep
*.qdstrm
*.sqlite
*.sqlite3
